config zte_mesh 'main'
	# Master switch, on by default. The service starts when this is 1 and the Wi-Fi
	# profile below is complete.
	option enabled '1'
	# Self-organizing network (the factory MESH switch): 1 = ZTE enhanced, only ZTE child routers with
	# the same market code are accepted; 0 = ZTE compatible, any child router is accepted (default).
	option mesh_v2 '0'
	# LAN bridge that carries the mesh control traffic (wired backhaul only), up to 15 characters.
	option bridge 'br-lan'
	# Wi-Fi 7 multi-link operation flag sent to the child routers (factory default 1).
	option mlo_enable '1'

	# Wi-Fi profile pushed to the child routers. radio 0 = 2.4 GHz, radio 1 = 5 GHz.
	option wifi_24g_enabled '1'
	option wifi_5g_enabled '1'
	# 1 = the 5 GHz band uses the 2.4 GHz name, password, security, hidden flag and MAC filter policy
	# (wifi_5g_ssid/key/security/hidden/acl_policy are ignored). With 0, set
	# wifi_5g_ssid / wifi_5g_key, or leave them out: the name becomes "<2.4 GHz name><wifi_5g_suffix>"
	# and the key the 2.4 GHz key, so the 5 GHz network is renamed on the child routers.
	option wifi_dual_band_sync '1'
	option wifi_5g_suffix '-5G'		# 1-8 characters
	option wifi_24g_ssid 'ImmortalWrt'	# 1-31 characters
	option wifi_24g_key 'Ztemesh2631!'	# 8-63 characters, default Ztemesh2631!
	# none | psk2 (WPA2) | psk-mixed (WPA/WPA2) | sae (WPA3) | sae-mixed (WPA2/WPA3)
	option wifi_24g_security 'sae-mixed'
	option wifi_5g_security 'psk-mixed'
	option wifi_24g_hidden '0'
	option wifi_5g_hidden '0'
	# Beacon interval, 20-1000 ms (factory 100).
	option wifi_24g_beacon_interval '100'
	option wifi_5g_beacon_interval '100'
	# Channel, 0 = automatic (factory). 2.4 GHz 1-13; 5 GHz 36-48, 52-64, 100-144, 149-165 in steps of 4.
	# Remove the option to keep each child router's own setting.
	option wifi_24g_channel '0'
	option wifi_5g_channel '0'
	# Transmit power, 0-30 dBm EIRP, rounded by the child routers to five levels. Full power (factory):
	# 2.4 GHz above 19, 5 GHz above 21. Remove the option to keep each child router's own setting.
	option wifi_24g_tx_power '20'
	option wifi_5g_tx_power '23'

	# Steering and roaming. Thresholds are -110 to -30 dBm and go in pairs (both bands or neither).
	option band_steer '1'			# factory: on while both bands share a name
	option band_steer_rssi_24g '-60'	# factory -60
	option band_steer_rssi_5g '-110'	# factory -110
	option roam_rssi_24g '-60'		# factory -60 (some child models, the Z506 among them, ignore it)
	option roam_rssi_5g '-70'		# factory -70
	option roam_force '0'			# kick devices on a weak signal, factory off

	# Optional, unset = keep the child routers' setting: wifi_{24g,5g}_acl_policy (disabled|ban|allow),
	# mesh_role (master|main|slave). master (the default, and what an unset value means) is a controller only:
	# it hands the profile to the child routers and leaves this router's own radios alone, which is the shape
	# most wired OpenWrt boxes have. main is the controller that also broadcasts: the same profile is applied
	# to this router through /etc/config/wireless as well. slave makes this router a mesh child: it hands
	# nothing out and takes its Wi-Fi profile from the controller, applied the same way. The old name of the
	# main router role, "auto", is still accepted and means exactly "main".
	#
	# How the child role builds the radio link back to the controller. off (default): only the main SSIDs are
	# applied, exactly as before. multi_ap: the hidden backhaul BSS the plan carries (MapAccessAttr 64) becomes
	# its own wifi-iface with multi_ap=2 and the main SSID of each band gets multi_ap=1, so 1905 frames cross
	# the radio as plain 4-address Ethernet. Needs hostapd built with Multi-AP support: the full wpad, not
	# wpad-basic. 802.11s is not used, its data frames carry a mesh header that a 1905 CMDU cannot cross.
	option backhaul 'off'
	#
	# Which wifi-device of this router carries a band, for boards that have two devices on one band (an ax3600
	# has an unused PCIe 5 GHz card next to the SoC's 5 GHz radio, both with band '5g'). Without the pin, wlan-sync
	# uses the only device of that band, or the only one that is not disabled; when that leaves two candidates it
	# applies nothing to the band and names these options in the log, rather than writing the controller's network
	# onto the wrong device. The value is a wifi-device section name of /etc/config/wireless:
	#	option wifi_2g 'radio2'
	#	option wifi_5g 'radio1'
	#
	# Extra SSIDs of the child routers (slots of one band must be 1, 2, 3 without a gap):
	#   config zte_mesh_bss
	#   	option band '24g'          # 24g | 5g
	#   	option slot '1'            # 1 guest, 2 spare, 3 hidden backhaul
	#   	option enabled '0'
	#   	option ssid 'guest'        # 1-31 characters
	#   	option key 'at-least-8-chars'   # 8-63 characters
	# MAC filter (up to 16 rules):
	#   config zte_mesh_acl
	#   	option mac 'aa:bb:cc:dd:ee:ff'
